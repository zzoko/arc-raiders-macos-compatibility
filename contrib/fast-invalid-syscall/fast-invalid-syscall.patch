+            {0x193f4,{0xa9bd57f6,0xa9014ff4,0xa9027bfd,0x910083fd}},  // syscall terminator emitter
+            {0x2ace0,{0xd0000148,0x911fe108,0x38614908,0x52800029}},  // fixed-register lookup
+            {0x2d4f8,{0xa9bd57f6,0xa9014ff4,0xa9027bfd,0x910083fd}},  // materialize rip offset
+            {0x1996c,{0xd100c3ff,0xa9014ff4,0xa9027bfd,0x910083fd}},  // emit runtime call
+            {0x19aec,{0xa9be4ff4,0xa9017bfd,0x910043fd,0xaa0103f4}},  // fall-through
+        };
+        bool ok=hooks[10] && hooks[11] && hooks[12];
+        uint32_t original[4]={};
+        for(auto &g:guards){uint32_t code[4];
+            ok=ok && dbg.readMemory(libraryBase+g.off,code,16) && !memcmp(code,g.code,16);}
+        if(ok) {
+            const uint64_t target=libraryBase+0x193f4;
+            ok=dbg.readMemory(target,original,16) && dbg.writeMemory(hooks[10],&libraryBase,8);
+            unsigned char trampoline[32];memcpy(trampoline,original,16);absBranch(trampoline+16,target+16);
+            ok=ok && dbg.adjustMemoryProtection(hooks[12],VM_PROT_READ|VM_PROT_WRITE,32) &&
+               dbg.writeMemory(hooks[12],trampoline,32) &&
+               dbg.adjustMemoryProtection(hooks[12],VM_PROT_READ|VM_PROT_EXECUTE,32);
+            unsigned char branch[16];absBranch(branch,hooks[11]);
+            ok=ok && dbg.adjustMemoryProtection(target,VM_PROT_READ|VM_PROT_WRITE|VM_PROT_COPY,16) &&
+               dbg.writeMemory(target,branch,16) &&
+               dbg.adjustMemoryProtection(target,VM_PROT_READ|VM_PROT_EXECUTE,16);
+            if(!ok)return 2;
+            LOG("ARC fast invalid-syscall emitter hook installed at 0x%llx\n",(unsigned long long)target);
+        } else {
+            LOG("ARC fast invalid-syscall path NOT installed (Rosetta layout differs)\n");
+        }
     }
     if(!dbg.detach())return 2;
 
