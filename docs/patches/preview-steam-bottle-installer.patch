+  for candidate in /Applications/*.app(N/) "$HOME"/Applications/*.app(N/); do
+    [[ $candidate != *[[:cntrl:]]* && -f $candidate/Contents/Info.plist && -d $candidate/Contents/SharedSupport/CrossOver ]] || continue
+    [[ $(app_build "$candidate") != $build ]] || matches+=("$candidate")
