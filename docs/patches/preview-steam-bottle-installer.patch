+    [[ $REPLY != 0 ]] || return 1
+    if valid_number "$REPLY" "$#matches"; then app=$matches[REPLY]; return 0; fi
+    if parse_location "$REPLY" && [[ -d $REPLY/Contents/SharedSupport/CrossOver && $(app_build "$REPLY") == $build ]]; then
